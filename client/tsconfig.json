{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/main.ts",
    "src/aiDirector.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "src/**/*backup*.ts",
    "src/**/*before*.ts",
    "src/main.backup.ts",
    "src/main.*.backup.ts",
    "src/main-*.ts"
  ]
}
